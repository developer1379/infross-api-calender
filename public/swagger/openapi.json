  "components": {
    "schemas": {
      "Teacher": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "department": { "type": "string" },
          "color": { "type": "string" },
          "availability": {
            "type": "array",
            "items": { "type": "string" }
          },
          "avatarUrl": { "type": "string", "nullable": true }
        }
      },
      "TeacherInput": {
        "type": "object",
        "required": ["name", "email"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "email": { "type": "string" },
          "department": { "type": "string" },
          "color": { "type": "string" },
          "availability": {
            "type": "array",
            "items": { "type": "string" }
          },
          "avatarUrl": { "type": "string", "nullable": true }
        }
      },
      "Course": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "department": { "type": "string" },
          "enrolledStudents": { "type": "integer" }
        }
      },
      "CourseInput": {
        "type": "object",
        "required": ["code", "name"],
        "properties": {
          "id": { "type": "string" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "department": { "type": "string" },
          "enrolledStudents": { "type": "integer" }
        }
      },
      "Room": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "capacity": { "type": "integer" },
          "type": { "type": "string", "enum": ["Lecture Hall", "Lab", "Seminar Room"] }
        }
      },
      "RoomInput": {
        "type": "object",
        "required": ["name", "capacity", "type"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "capacity": { "type": "integer" },
          "type": { "type": "string", "enum": ["Lecture Hall", "Lab", "Seminar Room"] }
        }
      },
      "ScheduleSession": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "teacherId": { "type": "string" },
          "courseId": { "type": "string" },
          "roomId": { "type": "string", "nullable": true },
          "day": { "type": "string", "nullable": true },
          "startTime": { "type": "string", "nullable": true },
          "endTime": { "type": "string", "nullable": true }
        }
      },
      "ScheduleSessionInput": {
        "type": "object",
        "required": ["teacherId", "courseId"],
        "properties": {
          "id": { "type": "string" },
          "teacherId": { "type": "string" },
          "courseId": { "type": "string" },
          "roomId": { "type": "string", "nullable": true },
          "day": { "type": "string", "nullable": true },
          "startTime": { "type": "string", "nullable": true },
          "endTime": { "type": "string", "nullable": true }
        }
      }
    }
  }
}
